  "copy": {
    "item00": "周末旧物修理站",
    "item01": "REPAIR TOGETHER",
    "item02": "2026.12.12",
    "item03": "10:00—17:00",
    "item04": "回声社区工坊",
    "item05": "01 可带物品",
    "item06": "衣物、布袋、木质小件与自行车配件。每人限带 2 件；请提前清洁，并保留拆下的零件。",
    "item07": "02 不接收范围",
    "item08": "电池、电源适配器、燃气设备和带液体的器具不在本次活动范围内，请勿带到现场。",
    "item09": "03 时间安排",
    "item10": "10:00—12:00 现场登记",
    "item11": "13:00—16:00 共同修理",
    "item12": "16:00—17:00 整理与交流",
    "item13": "04 参与方式",
    "item14": "无需预约，按到场顺序登记。未成年人须由成年人陪同；每件物品先检查，再决定是否适合现场处理。",
    "item15": "05 需要准备",
    "item16": "请携带物品、相关配件和一个收纳袋。现场提供常用手工具；特殊耗材请自备。",
    "item17": "06 费用与后续",
    "item18": "参与免费，替换材料按实际用量登记。无法当天处理的物品须自行带回，现场不提供寄存。",
    "item19": "咨询：hello@example.com"
  },
